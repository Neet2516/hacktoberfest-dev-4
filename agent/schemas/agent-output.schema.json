{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecterAgentOutput",
  "description": "Standard schema for verified output generated by a SPECTER agent.",
  "type": "object",
  "required": [
    "output_id",
    "agent_id",
    "task_id",
    "output_type",
    "summary",
    "data",
    "confidence_score",
    "created_at"
  ],
  "properties": {
    "output_id": {
      "type": "string",
      "pattern": "^out_[a-zA-Z0-9_-]+$"
    },
    "agent_id": {
      "type": "string",
      "enum": [
        "resurrection_coordinator",
        "repository_archaeologist",
        "issue_investigator",
        "ghost_repairer",
        "adversarial_reviewer",
        "test_engineer"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^SPECTER-[0-9]{3}$"
    },
    "output_type": {
      "type": "string",
      "enum": [
        "context_report",
        "investigation_report",
        "git_patch",
        "review_verdict",
        "verification_report",
        "maintenance_proposal"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "data": {
      "type": "object"
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "unverified",
        "verified",
        "rejected"
      ]
    },
    "validator_notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}